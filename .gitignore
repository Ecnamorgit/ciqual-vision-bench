# Clés d'API
.env
.env.*
!.env.example
*.key
secrets.json
lib/secrets.dart

# URL et jetons Nightscout — ton instance est nominative,
# ne la laisse pas fuiter dans un fichier de config d'exemple
nightscout.json
**/ns_config.dart

# Données de santé personnelles : photos de repas, base de mesures,
# exports CSV. Ce sont des données de l'article 9 du RGPD.
data/
photos/
*.db
*.sqlite
*.sqlite3
mesures*.csv
export*.csv

